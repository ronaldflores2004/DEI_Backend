# =====================================================
# Base de datos y seguridad
# =====================================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/dei
SECRET_KEY=cambia-esto-por-una-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000

# development o production. En production no se permite FAKE.
APP_ENV=development

# Clave(s) para cifrar diarios, audios y notas clínicas.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardar una copia fuera del servidor: si se pierde, los datos no se recuperan.
# Para rotar: NUEVA,ANTERIOR (la primera cifra, todas descifran).
DATA_ENCRYPTION_KEYS=

# País de las líneas de crisis que ve el paciente (BO, PE, MX, ES, US).
CRISIS_COUNTRY=BO

# =====================================================
# Proveedores de IA
# =====================================================
# Orden en que se prueban. Si uno falla (apagado, timeout,
# respuesta inválida) se usa el siguiente.
# FAKE solo para desarrollo: inventa resultados.
AI_PROVIDER_CHAIN=OLLAMA,GEMINI

# Gemini (respaldo). Puede quedar vacío si solo usas la IA local.
GEMINI_API_KEY=

# =====================================================
# IA local: Ollama
# =====================================================
# IP de la laptop donde corre Ollama (la Nitro 5) en la red local.
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# =====================================================
# Transcripción de audio: Whisper
# =====================================================
# WHISPER_API -> servidor Whisper en otra máquina (recomendado)
# LOCAL       -> Whisper dentro del backend (pip install faster-whisper)
TRANSCRIPTION_PROVIDER=WHISPER_API
WHISPER_API_URL=http://192.168.1.50:8000
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT_SECONDS=300
